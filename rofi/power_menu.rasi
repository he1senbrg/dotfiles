configuration {
    show-icons: false;
}

* {
    background:     #282828FF;
    background-alt: #353535FF;

    foreground:     #EBDBB2FF;

    selected:       #83A598FF;
    active:         #B8BB26FF;
    urgent:         #FB4934FF;

    font: "JetBrains Mono Nerd Font 10";
}

window {
    transparency:      "real";
    location:          center;
    anchor:            center;

    fullscreen:        false;
    width:             800px;

    x-offset:          0px;
    y-offset:          0px;

    margin:            0px;
    padding:           0px;

    border:            0px solid;
    border-radius:     20px;
    border-color:      @selected;

    background-color:  @background;
    cursor:            "default";
}

mainbox {
    children:          [ "message", "listview" ];

    spacing:           15px;
    padding:           20px;

    background-color:  transparent;
}

inputbar {
    children:          [ "textbox-prompt-colon", "prompt" ];

    spacing:           15px;

    background-color:  transparent;
    text-color:        @foreground;
}

textbox-prompt-colon {
    enabled:           true;
    expand:            false;

    str:               "";

    padding:           12px 16px;

    background-color:  @urgent;
    text-color:        @background;
}

prompt {
    enabled:           true;

    padding:           12px;

    background-color:  @active;
    text-color:        @background;
}

message {
    margin:            0px 70px;
    padding:           12px;

    border-radius:     15px;

    background-color:  @background-alt;
    text-color:        @foreground;
}

textbox {
    background-color:  inherit;
    text-color:        inherit;

    horizontal-align:  0.5;
    vertical-align:    0.5;

    placeholder-color: @foreground;
    markup:            true;
    blink:             true;
}

error-message {
    padding:           12px;

    background-color:  @background;
    text-color:        @foreground;
}

listview {
    columns:           5;
    lines:             1;

    layout:            vertical;
    cycle:             true;
    dynamic:           true;

    fixed-height:      true;
    fixed-columns:     true;
    reverse:           false;
    scrollbar:         false;

    spacing:           15px;

    background-color:  transparent;
    text-color:        @foreground;
}

element {
    padding:           40px 10px;

    border-radius:     20px;

    background-color:  @background-alt;
    text-color:        @foreground;

    cursor:            pointer;
}

element-text {
    font:              "feather bold 32";

    background-color:  transparent;
    text-color:        inherit;

    horizontal-align:  0.5;
    vertical-align:    0.5;

    cursor:            inherit;
}

element selected.normal {
    background-color:  @selected;
    text-color:        @background;
}

dummy {
    background-color: transparent;
}